# =================================================================
# Sri Krishna Ayurvedic Clinic - Environment Variables
# =================================================================
# Copy this file to .env for local development
# For Vercel: Add these as Environment Variables in Vercel Dashboard
# =================================================================

# ------------------------------------
# DATABASE (Required for Production)
# ------------------------------------
# For Vercel: Use a cloud PostgreSQL like Supabase (free tier available)
# Get this from: Supabase Dashboard → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# For local development only (not needed if using DATABASE_URL):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=krish966
DB_USER=krish966
DB_PASSWORD=your_local_password
DB_SSL=false

# ------------------------------------
# SERVER (Optional, defaults shown)
# ------------------------------------
PORT=5000
NODE_ENV=production

# ------------------------------------
# SECURITY (Change this in production!)
# ------------------------------------
JWT_SECRET=your_secure_random_jwt_secret_key_here_change_this

# ------------------------------------
# ADMIN CREDENTIALS (stored in DB)
# ------------------------------------
# Admin user is created in the database via the setup script.
# Default admin credentials after running setup_supabase.js:
#   Email: srikrishna@srikrishnaayurveda.com
#   Password: Srikrishna@321
